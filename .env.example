# ===== 复制为 .env 后填写真实值，不要提交真实密钥到 Git =====
# 域名（生产填写你的域名，本地可用 localhost）
DOMAIN=localhost
NODE_ENV=development
PORT=4000
# FRONTEND_URL：演示版不再用于支付跳转（跳转已改相对路径 /pay/success，走同一域名 Nginx）。
# 如有其他地方需要绝对 URL，生产请填 https://你的域名；本地可留空。
FRONTEND_URL=

# JWT（后台登录用，生产必须换成强随机字符串）
JWT_SECRET=change-me-to-a-strong-random-secret

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=shop_db
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=change-me-strong-password

# Redis
REDIS_URL=redis://:change-me-redis-password@redis:6379
REDIS_PASSWORD=change-me-redis-password

# 支付模式：true = 本地 mock（模拟支付成功，仅联调用）；false = 真实支付（生产必须）
PAYMENT_MOCK=true

# ===== 支付宝（生产必填，本地 mock 可留空） =====
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://shop.example.com/api/payments/alipay/notify
ALIPAY_RETURN_URL=https://shop.example.com/pay/success

# ===== 微信支付（生产必填，本地 mock 可留空） =====
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=https://shop.example.com/api/payments/wechat/notify
WECHAT_CERT_PATH=/app/certs/wechat-apiclient-key.pem
